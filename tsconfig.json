{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "types": [
      "node"
    ],
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@buxa/shared": [
        "./apps/shared/src/index.ts"
      ],
      "@buxa/shared/*": [
        "./apps/shared/src/*"
      ],
      "@buxa/server": [
        "./apps/server/src/index.ts"
      ],
      "@buxa/server/*": [
        "./apps/server/src/*"
      ],
      "@buxa/middleware": [
        "./apps/middleware/src/index.ts"
      ],
      "@buxa/middleware/*": [
        "./apps/middleware/src/*"
      ]
    }
  },
  "include": [
    "packages",
    "apps/shared",
    "apps/server",
    "apps/middleware",
    "scripts",
    "test",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web"
  ]
}
