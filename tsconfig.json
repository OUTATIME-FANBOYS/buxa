{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "types": [
      "node"
    ],
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@buxa/domain": [
        "packages/domain/src/index.ts"
      ],
      "@buxa/db": [
        "packages/db/src/index.ts"
      ],
      "@buxa/contracts": [
        "packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "apps",
    "packages",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
