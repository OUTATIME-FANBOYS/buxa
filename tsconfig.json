{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "types": [
      "node"
    ],
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "packages",
    "scripts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web"
  ]
}
