{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@buxa/shared": ["../shared/src/index.ts"],
      "@buxa/shared/*": ["../shared/src/*"],
      "@buxa/server": ["../server/src/index.ts"],
      "@buxa/server/*": ["../server/src/*"],
      "@buxa/middleware": ["../middleware/src/index.ts"],
      "@buxa/middleware/*": ["../middleware/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
