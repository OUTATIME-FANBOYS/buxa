# Copy to apps/web/.env.local (git-ignored). One file holds everything the web app and the API need.

# --- Public values (safe for the browser) from Supabase: Project Settings > API ---
# Use the publishable (anon) key only. Never put a secret or service_role key in the web app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server only (never exposed to the browser) ---
# The database. Locally: the Postgres from `docker compose up -d db`.
DATABASE_URL=postgres://buxa:buxa@localhost:5433/buxa
# Optional. A direct (non-pooled) connection used only to run migrations. Defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgres://...
# Optional. Connections per server instance (default 10) and log level (default info).
# DB_POOL_MAX=5
# LOG_LEVEL=info

# Optional. 'true' lets the original kanban demo sync with its old local server (`npm run server`).
# NEXT_PUBLIC_LEGACY_SYNC=true
