{
  "name": "kanban",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite apps/web",
    "build": "tsc --noEmit && npm run build:web && npm run build:api",
    "test": "vitest run",
    "preview": "vite preview apps/web",
    "server": "tsx apps/web/server/index.ts",
    "server:dev": "tsx watch apps/web/server/index.ts",
    "start": "npm run build && tsx apps/web/server/index.ts",
    "db:migrate": "tsx packages/db/src/cli.ts",
    "api": "tsx apps/api/src/server.ts",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "build:web": "vite build apps/web",
    "build:api": "esbuild apps/api/src/server.ts packages/db/src/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outdir=dist-api --entry-names=[name] --out-extension:.js=.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
