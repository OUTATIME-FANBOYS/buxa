{
  "name": "buxa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev apps/web -p 5173",
    "build": "next build apps/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "server": "tsx apps/web/legacy-server/index.ts",
    "server:dev": "tsx watch apps/web/legacy-server/index.ts",
    "start": "next start apps/web",
    "db:migrate": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli.ts",
    "seed:mock": "tsx --conditions=react-server --env-file-if-exists=apps/web/.env.local scripts/seed-mock.ts",
    "seed:reset": "tsx --conditions=react-server --env-file-if-exists=apps/web/.env.local scripts/seed-mock.ts --reset",
    "typecheck": "tsc --noEmit && next typegen apps/web && tsc --noEmit -p apps/web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^25.0.1",
    "jsqr": "1.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^2.1.9"
  },
  "workspaces": [
    "packages/*",
    "apps/shared",
    "apps/server",
    "apps/middleware"
  ]
}
