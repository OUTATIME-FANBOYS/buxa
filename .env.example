# Admin connection: runs migrations and test seeding. Never used for request handling.
DATABASE_URL=postgres://buxa:buxa@localhost:5433/buxa

# Supabase project URL (Project Settings > API). Public value, not a secret.
# Also enable asymmetric JWT signing keys (Project Settings > JWT Keys); the API verifies tokens with the public keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Optional. A direct (non-pooled) connection used only for migrations. Defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgres://...
# Optional. Folder with the built web app; when set the API serves it too (the Docker image sets this).
# STATIC_DIR=apps/web/dist
